{
  "name": "tjaldur",
  "version": "0.1.0",
  "private": true,
  "description": "Iceland camping weather-window planner — Cloudflare Worker (MCP + REST + map website)",
  "type": "module",
  "scripts": {
    "dev": "vite dev web",
    "build": "vite build web",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 4",
    "check": "tsc --noEmit && tsc -b web && eslint . --max-warnings 4 && vitest run",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.2.10",
    "hono": "4.12.23",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.0",
    "@cloudflare/vitest-pool-workers": "0.16.13",
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "eslint-plugin-react-doctor": "0.2.11",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vitest": "4.1.8",
    "wrangler": "4.98.0"
  }
}
